# ---------------------------------------------------------------
# Plantilla de configuración.
#
# Copia este archivo como  .env  y completa los valores reales.
# El archivo .env está excluido en .gitignore y no debe subirse nunca.
#
# Este archivo (.env.ejemplo) SÍ se sube: sirve para que cualquiera
# que clone el repositorio sepa qué variables necesita.
# ---------------------------------------------------------------

ODOO_URL=https://tu-servidor-odoo.com
ODOO_DB=nombre_de_la_base_de_datos
ODOO_USER=tu_usuario@tu-empresa.com
ODOO_API_KEY=pega_aqui_tu_clave_api

# Cómo cargarlas antes de ejecutar un script:
#
#   Windows (PowerShell), solo para la ventana actual:
#     $env:ODOO_URL="https://tu-servidor-odoo.com"
#     $env:ODOO_DB="nombre_de_la_base_de_datos"
#     $env:ODOO_USER="tu_usuario@tu-empresa.com"
#     $env:ODOO_API_KEY="tu_clave"
#
#   Windows, de forma permanente para tu usuario:
#     setx ODOO_API_KEY "tu_clave"
#     (cierra y vuelve a abrir la terminal para que tome efecto)
#
#   Linux o macOS:
#     export ODOO_API_KEY="tu_clave"